# Copy to .env for running the API or worker directly on your machine
# (docker compose sets these itself). Every setting is prefixed with RELAY_.

RELAY_ENVIRONMENT=development
RELAY_DATABASE_URL=postgresql+asyncpg://relay:relay@localhost:5433/relay
RELAY_DATABASE_POOL_SIZE=10
RELAY_REDIS_URL=redis://localhost:6379/0
RELAY_LOG_LEVEL=INFO
# false = coloured human-readable logs, true = one JSON object per line
RELAY_LOG_JSON=false
RELAY_WORKER_POLL_INTERVAL_SECONDS=1.0

# Dashboard sessions. In production RELAY_JWT_SECRET is required and must be a
# random value of at least 32 characters, e.g. from: openssl rand -base64 48
# RELAY_JWT_SECRET=
RELAY_ACCESS_TOKEN_TTL_SECONDS=900
RELAY_REFRESH_TOKEN_TTL_DAYS=30
# JSON list of browser origins allowed to call the API with cookies
RELAY_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000"]
RELAY_LOGIN_ATTEMPTS_PER_MINUTE=10
RELAY_REGISTRATIONS_PER_HOUR=10

# Endpoints and events. In production RELAY_ENCRYPTION_KEY is required:
# base64 of 32 random bytes, e.g. from: openssl rand -base64 32
# RELAY_ENCRYPTION_KEY=
RELAY_MAX_EVENT_BYTES=262144
RELAY_SECRET_ROTATION_OVERLAP_HOURS=24

# Built-in test receiver. RELAY_RECEIVER_BASE_URL is the API's address as the
# workers reach it. RELAY_DELIVERY_ONLY_TO_RECEIVER=true restricts all deliveries
# to the built-in receiver (use it for a public demo).
RELAY_RECEIVER_BASE_URL=http://localhost:8000
RELAY_DELIVERY_ONLY_TO_RECEIVER=false
