# Copy to .env for running the API or worker directly on your machine
# (docker compose sets these itself). Every setting is prefixed with RELAY_.

RELAY_ENVIRONMENT=development
RELAY_DATABASE_URL=postgresql+asyncpg://relay:relay@localhost:5433/relay
RELAY_DATABASE_POOL_SIZE=10
RELAY_REDIS_URL=redis://localhost:6379/0
RELAY_LOG_LEVEL=INFO
# false = coloured human-readable logs, true = one JSON object per line
RELAY_LOG_JSON=false
RELAY_WORKER_POLL_INTERVAL_SECONDS=1.0

# Dashboard sessions. In production RELAY_JWT_SECRET is required and must be a
# random value of at least 32 characters, e.g. from: openssl rand -base64 48
# RELAY_JWT_SECRET=
RELAY_ACCESS_TOKEN_TTL_SECONDS=900
RELAY_REFRESH_TOKEN_TTL_DAYS=30
# JSON list of browser origins allowed to call the API with cookies
RELAY_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8080","http://localhost:8000"]
RELAY_LOGIN_ATTEMPTS_PER_MINUTE=10
RELAY_REGISTRATIONS_PER_HOUR=10
# How long an invitation link stays valid
RELAY_INVITATION_TTL_DAYS=7

# Endpoints and events. In production RELAY_ENCRYPTION_KEY is required:
# base64 of 32 random bytes, e.g. from: openssl rand -base64 32
# RELAY_ENCRYPTION_KEY=
RELAY_MAX_EVENT_BYTES=262144
RELAY_SECRET_ROTATION_OVERLAP_HOURS=24

# Built-in test receiver. RELAY_RECEIVER_BASE_URL is the API's address as the
# workers reach it. RELAY_DELIVERY_ONLY_TO_RECEIVER=true restricts all deliveries
# to the built-in receiver (use it for a public demo).
RELAY_RECEIVER_BASE_URL=http://localhost:8000
RELAY_DELIVERY_ONLY_TO_RECEIVER=false
# JSON list of seconds before each attempt; shorten for demos, e.g. [0, 2, 2]
RELAY_RETRY_SCHEDULE_SECONDS=[0, 30, 120, 600, 3600, 21600, 86400]

# Retention: finished events older than this many days are deleted, with their
# deliveries and attempts. Events with a delivery still on its way are kept.
RELAY_RETENTION_DAYS=30
RELAY_RETENTION_BATCH_SIZE=1000
# How often the worker runs housekeeping (retention, demo reset), in seconds
RELAY_MAINTENANCE_INTERVAL_SECONDS=300

# Demo data, created by: python -m relay.seed (safe to run more than once).
# The demo password is shared with visitors, so it is not a secret, but change
# it on a public demo. At least 10 characters.
RELAY_DEMO_ORGANIZATION_NAME=Relay Demo
RELAY_DEMO_EMAIL=demo@example.com
RELAY_DEMO_PASSWORD=relay-demo-account
# Public demo only. When true, ALL data (every visitor's organisation too) is
# deleted once a day at this hour (UTC) and the demo is seeded again.
RELAY_DEMO_MODE=false
RELAY_DEMO_RESET_HOUR_UTC=3

# Tracing: an OTLP/HTTP collector such as Jaeger or Tempo. Unset = off.
# RELAY_OTLP_ENDPOINT=http://localhost:4318

# Host ports for `docker compose up`, if the defaults are taken on your machine.
# The API is reachable on this machine only; visitors use the dashboard on 8080.
# RELAY_API_HOST_PORT=8000
# RELAY_POSTGRES_HOST_PORT=5433
# RELAY_REDIS_HOST_PORT=6379
